<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  RL-InternalRateLimit
  Higher quota for internal systems: 1000 requests per minute.
-->
<Quota name="RL-InternalRateLimit">
  <DisplayName>RL-InternalRateLimit</DisplayName>
  <Allow count="1000"/>
  <Interval>1</Interval>
  <TimeUnit>minute</TimeUnit>
  <Identifier ref="client_id"/>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
</Quota>
